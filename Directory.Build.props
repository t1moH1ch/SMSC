<Project>
  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <TargetFrameworks>netstandard2.0;net9.0;net10.0</TargetFrameworks>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    <DebugType>embedded</DebugType>
    <Utf8Output>true</Utf8Output>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseCommonOutputDirectory>false</UseCommonOutputDirectory>
    <RepoRoot>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))))</RepoRoot>
  </PropertyGroup>

  <!-- netstandard2.0 reference assemblies lack nullability annotations used by modern APIs -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <NoWarn>$(NoWarn);CS8601;CS8603;CS8604;CS8777</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <BaseOutputPath>$(RepoRoot)artifacts\</BaseOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <BaseOutputPath>$(RepoRoot)artifacts\</BaseOutputPath>
  </PropertyGroup>
</Project>
